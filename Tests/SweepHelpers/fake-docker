#!/usr/bin/env python3
"""Stand-in for `docker` used by tests/docker-sweep.sh.

Serves a fixed set of containers from $FAKE_DOCKER_STATE (JSON written by the
test) and appends every state-changing command to $FAKE_DOCKER_LOG.
"""
import json, os, sys

state = json.load(open(os.environ["FAKE_DOCKER_STATE"]))
args = sys.argv[1:]

def record():
    with open(os.environ["FAKE_DOCKER_LOG"], "a") as log:
        log.write(" ".join(args) + "\n")

if args[:2] == ["ps", "-aq"]:
    print("\n".join(c["Id"] for c in state["containers"]))
elif args[0] == "inspect":
    print(json.dumps([c for c in state["containers"] if c["Id"] in args[1:]]))
elif args[0] == "logs":
    line = state["logs"].get(args[-1], "")
    # Mirror images that log to stderr, as Postgres does.
    print(line, file=sys.stderr if state.get("logs_to_stderr") else sys.stdout)
elif args[:2] == ["network", "ls"]:
    project = args[-1].rsplit("=", 1)[-1]
    print(state["networks"].get(project, ""))
elif args[0] in ("rm", "stop") or args[:2] == ["network", "rm"]:
    record()
else:
    sys.exit(f"fake-docker: unexpected {args}")
